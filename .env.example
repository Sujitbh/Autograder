# Database
POSTGRES_USER=autograder_user
POSTGRES_PASSWORD=autograder_pass
POSTGRES_DB=autograder
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# JWT
JWT_SECRET=change-me-now

# Frontend
VITE_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# MFA / OTP — default in code is OFF. Set MFA_ENABLED=true for production-like OTP.
# If you still get OTP after editing .env: restart the backend, and run `unset MFA_ENABLED`
# (shell/IDE env vars override .env).
# MFA_ENABLED=true
# MFA_BYPASS_ENABLED=true
# MFA_BYPASS_ACCOUNTS=faculty@ulm.edu,student@warhawks.ulm.edu
